{
  "schema": "sage.session_state.v1",
  "required": [
    "canonical_git_sha",
    "active_mission",
    "required_interfaces",
    "acceptance_status",
    "identity_contract"
  ],
  "identity_contract": {
    "nameplate": "sage/experimental/airspace/nameplate.py",
    "hud": "sage/agent_hud_projection.py",
    "immersion_doctrine": "docs/SAGE-INVENTOR-AGENT-IMMERSION-DOCTRINE.md",
